#pragma kernel ClusterCullingReflectionProbeCS

#pragma enable_d3d11_debug_symbols

#define PI 3.14159265358979323846
#define FLT_MIN  1.175494351e-38
#define FLT_MAX  3.402823466e+38
#define HALF_MIN 6.103515625e-5
#define HALF_MAX 65504.0
#define UINT_MIN 0
#define UINT_MAX 0xFFFFFFFFu

#define MAX_REFLECTION_PROBES_ON_SCREEN (64)

struct ReflectionProbeData4CS
{
    float3 boundCenter;
    float3 boundExtents;
};

RWStructuredBuffer<uint> _ClusterCullingReflectionProbeMaskBuffer;
StructuredBuffer<ReflectionProbeData4CS> _ClusterCullingReflectionProbeDatas4CSBuffer;
// x:z scale y:z offset z:wordsPerCluster w:isOrthographic
float4 _ClusterCullingReflectionProbeParams0;
// xyz:clusterSize w:probeCount
float4 _ClusterCullingReflectionProbeParams1;
float4x4 _ClusterCullingReflectionProbeClipToView;
float4x4 _ClusterCullingReflectionProbeViewToClip;
float4x4 _ClusterCullingReflectionProbeClipToWorld;

void EncodeHeader(uint min, uint max, inout uint result)
{
    result = (min & 0xFFFF) | ((max & 0xFFFF) << 16);
}

void DecodeHeader(uint bin, inout uint min, inout uint max)
{
    min = bin & 0xFFFF;
    max = (bin >> 16) & 0xFFFF;
}

void UpdateHeader(inout uint header, uint index)
{
    index &= 0xFFFF;
    if(index < (header & 0xFFFF))
    {
        header &= 0xFFFF0000u;
        header |= index;
    }
    if(index > ((header >> 16) & 0xFFFF))
    {
        header &= 0x0000FFFFu;
        header |= index << 16;
    }
}

[numthreads(8, 8, 1)]
void ClusterCullingReflectionProbeCS(uint3 id : SV_DispatchThreadID)
{    
    float2 clusterZScaleOffset = _ClusterCullingReflectionProbeParams0.xy;
    uint wordsPerCluster = asuint(int(_ClusterCullingReflectionProbeParams0.z));
    bool isOrthographic = _ClusterCullingReflectionProbeParams0.w > 0.5;
    uint3 clusterSize = uint3(asuint(int(_ClusterCullingReflectionProbeParams1.x)), asuint(int(_ClusterCullingReflectionProbeParams1.y)), asuint(int(_ClusterCullingReflectionProbeParams1.z)));
    uint probeCount = asuint(int(_ClusterCullingReflectionProbeParams1.w));

    // 越界线程必须在任何写入之前退出：线程组按 8 向上取整，
    // id 可能 >= clusterSize（旧版用 > 判断且先清零，会越界写坏掩码缓冲）。
    if(
        id.x >= clusterSize.x
        || id.y >= clusterSize.y
        || id.z >= clusterSize.z
    )
    {
        return;
    }

    uint clusterIndexZ = id.z;
    uint clusterIndexY = id.y;
    uint clusterIndexX = id.x;

    // 线性簇索引：保证 (x,y,z) -> 索引为单射，避免不同簇共用 header / 掩码字。
    uint clusterIndex =
        clusterIndexX
        + clusterIndexY * clusterSize.x
        + clusterIndexZ * clusterSize.x * clusterSize.y;
    uint headerIndex = clusterIndex * wordsPerCluster;

    _ClusterCullingReflectionProbeMaskBuffer[headerIndex] = 0u;
    for(uint wordClearIndex = 0; wordClearIndex < wordsPerCluster; wordClearIndex++)
    {
        _ClusterCullingReflectionProbeMaskBuffer[headerIndex + 1 + wordClearIndex] = 0u;
    }
    
    // header中写入初始值
    uint header = 0;
    EncodeHeader(0xFFFFFFFFu, 0, header);

    // 计算当前cluster在clip space下的minmax
    float3 clusterMinCS, clusterMaxCS;
    float2 clusterMinMaxZVS;
    float zSize = pow(2, clusterSize.z);
    clusterMinMaxZVS.x = ((float)clusterIndexZ - clusterZScaleOffset.y) / clusterZScaleOffset.x;
    clusterMinMaxZVS.y = ((float)clusterIndexZ + 1 - clusterZScaleOffset.y) / clusterZScaleOffset.x;
    // Perspective uses log2-sliced cluster depths: (i - offset) / scale is
    // log2(viewZ), so it must be exponentiated back to a real view-space depth.
    // Orthographic uses linear-sliced depths and must NOT be exponentiated.
    clusterMinMaxZVS.x = isOrthographic ? clusterMinMaxZVS.x : pow(2, clusterMinMaxZVS.x);
    clusterMinMaxZVS.y = isOrthographic ? clusterMinMaxZVS.y : pow(2, clusterMinMaxZVS.y);
    // cluster depths are positive view-space distances; the projection matrix
    // expects negative view z (camera looks down -Z), so negate before projecting.
    // 投影得到的是齐次裁剪坐标，必须除以 w 才是 NDC z；直接用 .z 会让反投影深度错误。
    float4 clipMinZ = mul(_ClusterCullingReflectionProbeViewToClip, float4(0, 0, -clusterMinMaxZVS.x, 1));
    float4 clipMaxZ = mul(_ClusterCullingReflectionProbeViewToClip, float4(0, 0, -clusterMinMaxZVS.y, 1));
    clusterMinCS.z = clipMinZ.z / clipMinZ.w;
    clusterMaxCS.z = clipMaxZ.z / clipMaxZ.w;
    clusterMinCS.xy = float2((float)clusterIndexX / clusterSize.x, (float)clusterIndexY / clusterSize.y) * 2 - 1;
    clusterMaxCS.xy = float2((float)(clusterIndexX + 1) / clusterSize.x, (float)(clusterIndexY + 1) / clusterSize.y) * 2 - 1;
    clusterMinCS = max(clusterMinCS, float3(-1, -1, 0));
    clusterMaxCS = min(clusterMaxCS, float3(1, 1, 1));
    
    // 计算当前cluster在world space下的AABB
    float3 clusterMinWS = float3(FLT_MAX, FLT_MAX, FLT_MAX);
    float3 clusterMaxWS = float3(-FLT_MAX, -FLT_MAX, -FLT_MAX);
    for(uint pointIndex = 0; pointIndex < 8; pointIndex++)
    {
        float3 pointCS;
        pointCS.x = (pointIndex >> 2 & 1) == 1 ? clusterMaxCS.x : clusterMinCS.x;
        pointCS.y = (pointIndex >> 1 & 1) == 1 ? clusterMaxCS.y : clusterMinCS.y;
        pointCS.z = (pointIndex & 1) == 1 ? clusterMaxCS.z : clusterMinCS.z;
        // clipToWorld 是透视矩阵的逆，结果为齐次坐标，必须除以 w 才是世界坐标。
        float4 pointWSH = mul(_ClusterCullingReflectionProbeClipToWorld, float4(pointCS, 1));
        float3 pointWS = pointWSH.xyz / pointWSH.w;
        clusterMinWS = min(clusterMinWS, pointWS);
        clusterMaxWS = max(clusterMaxWS, pointWS);
    }

    // 遍历probe
    for(uint probeIndex = 0; probeIndex < MAX_REFLECTION_PROBES_ON_SCREEN; probeIndex++)
    {
        ReflectionProbeData4CS probeData = _ClusterCullingReflectionProbeDatas4CSBuffer[probeIndex];
        uint wordIndex = probeIndex / 32;
        uint bitMask = 1u << (probeIndex % 32);
        if(probeIndex < probeCount)
        {
            // 计算probe在view space下的minmax
            float3 centerWS = probeData.boundCenter.xyz;
            float3 extentsWS = probeData.boundExtents.xyz;
            float3 probeMinWS = centerWS - extentsWS;
            float3 probeMaxWS = centerWS + extentsWS;

            // 判断probe与cluster是否相交
            if(
                clusterMinWS.x < probeMaxWS.x
                && clusterMinWS.y < probeMaxWS.y
                && clusterMinWS.z < probeMaxWS.z
                && clusterMaxWS.x > probeMinWS.x
                && clusterMaxWS.y > probeMinWS.y
                && clusterMaxWS.z > probeMinWS.z
            )
            {
                UpdateHeader(header, probeIndex);

                _ClusterCullingReflectionProbeMaskBuffer[headerIndex + 1 + wordIndex] |= bitMask;
            }
        }
        else
        {
            _ClusterCullingReflectionProbeMaskBuffer[headerIndex + 1 + wordIndex] &= ~bitMask;
        }
    }
    _ClusterCullingReflectionProbeMaskBuffer[headerIndex] = header;
}